APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jobpulse
POSTGRES_USER=jobpulse
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
